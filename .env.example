# Burrow configuration. Every variable is optional.
# Copy to .env and reference it from docker-compose.yml with `env_file: .env`,
# or set the variables under `environment:`.

# Key used to encrypt the Cloudflare API token at rest (AES-256-GCM, derived
# with HKDF). 32+ random characters, e.g.: openssl rand -base64 48
# If unset, a random key is generated once into /data/.secret (mode 0600).
# Do not change it later: the stored token could no longer be decrypted and
# you would have to enter it again.
BURROW_SECRET=

# Secure flag on the session cookie: auto, true or false.
# "auto" sets it when the dashboard is reached over HTTPS.
BURROW_SECURE_COOKIES=auto

# Set when the dashboard sits behind a reverse proxy (including when you
# publish Burrow itself through the tunnel), so client IPs and HTTPS are
# detected correctly: true, a hop count (1) or a list of addresses/CIDRs.
TRUST_PROXY=false

# HTTP port of the dashboard inside the container.
PORT=8080

# Log level: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# Time zone used in logs.
TZ=UTC

# Advanced, normally left alone (the image sets sensible defaults):
# DATA_DIR=/data
# CLOUDFLARED_PATH=/usr/local/bin/cloudflared
# WEB_DIST_DIR=/app/web
# RECONCILE_INTERVAL_SECONDS=300     # 0 disables the periodic resync
# HEALTHCHECK_INTERVAL_SECONDS=60    # 0 disables origin probes
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
